  "root": "toktier",
  "schema": "toktier.rust_compiled_closure.v2",
  "selections": [
    {
      "features": "default,prebuilt-gpu,serving,sqlite",
      "target": "x86_64-unknown-linux-gnu"
    },
    {
      "features": "default,jit,prebuilt-gpu,serving,sqlite",
      "target": "x86_64-unknown-linux-gnu"
    }
  ],
  "tier_rule": {
    "behavior_sources": {
      "icu_properties_data": "crate-version",
      "onig": "runtime:onig::version",
      "regex": "probe:regex-age",
      "unicode-segmentation": "const:UNICODE_VERSION",
      "unicode_categories": "crate-version"
    },
    "behavior_units": {
      "icu_properties_data": "icu_properties_data",
      "onig": "onig",
      "onig_sys": "onig",
      "regex": "regex",
      "regex-automata": "regex",
      "regex-syntax": "regex",
      "unicode-segmentation": "unicode-segmentation",
      "unicode_categories": "unicode_categories"
    },
    "compiled_set_command": "cargo tree --locked --offline --package toktier --edges normal,build --target <target> --prefix none --format {p} [--features <features>]",
    "encode_path_exclusions": [
      "crates/toktier/src/artifact.rs",
      "crates/toktier/src/bundle.rs",
      "crates/toktier/src/diagnostics.rs",
      "crates/toktier/src/error.rs",
      "crates/toktier/src/fsutil.rs",
      "crates/toktier/src/package_data.rs",
      "crates/toktier/src/serving.rs",
      "crates/toktier/src/suggest.rs",
      "crates/toktier/src/bin/"
    ],
    "engine_crates": [
      "toktier-gigatoken-core",
      "toktier-routing-core",
      "toktier-cuda-driver"
    ],
    "graph_command": "cargo metadata --format-version 1 --locked --offline --filter-platform <target> [--features <features>]",
    "name_net": "^(regex|fancy-regex|onig|pcre|unicode[-_]|icu_|ucd|spm_|.*normaliz|.*segment|.*graphem|tokenizers)",
    "statement": "The certified core is R0 the workspace members, R1 their non-development direct dependencies that encode-path sources name, and R2 the text-semantics libraries reachable from an engine crate through normal edges. Everything else this build compiles is periphery: it is compared and reported, and it does not decide certification. R0 and R1 are pinned exactly by our own edges, so they cannot move by version; R2 is compared by behaviour version, and its package versions are reported in the advisory.",
    "text_semantics_table": {
      "icu_collections": {
        "reason": "code point set and trie containers; they carry no Unicode knowledge of their own",
        "tier": "periphery"
      },
      "icu_locale_core": {
        "reason": "locale identifier plumbing for the compiled-data provider",
        "tier": "periphery"
      },
      "icu_properties_data": {
        "reason": "the Unicode property tables behind icu_properties, which are the fast CPU pre-tokenizer's character classes",
        "tier": "core"
      },
      "icu_provider": {
        "reason": "data provider plumbing for the compiled-data provider",
        "tier": "periphery"
      },
      "onig": {
        "reason": "the Oniguruma binding the reference engine uses for every byte-level BPE family's split pattern",
        "tier": "core"
      },
      "onig_sys": {
        "reason": "the Oniguruma C library behind onig; its built-in Unicode tables define the classes those patterns name",
        "tier": "core"
      },
      "regex": {
        "reason": "the regex crate the reference engine uses for added-token boundaries and whitespace stripping; its Unicode class semantics decide where those splits fall",
        "tier": "core"
      },
      "regex-automata": {
        "reason": "the engine behind regex",
        "tier": "core"
      },
      "regex-syntax": {
        "reason": "the parser and Unicode class tables behind regex",
        "tier": "core"
      },
      "unicode-ident": {
        "reason": "the identifier tables proc-macro2 reads while macros expand; not linked into the running artifact",
        "tier": "periphery"
      },
      "unicode-segmentation": {
        "reason": "grapheme and word segmentation in the reference engine's BERT pre-tokenizer, strip normalizer and normalizer core; the algorithm moves with the Unicode version",
        "tier": "core"
      },
      "unicode-width": {
        "reason": "display width for the progress bars of indicatif and console; not on the encode path",
        "tier": "periphery"
      },
      "unicode_categories": {
        "reason": "general-category tests in the reference engine's punctuation pre-tokenizer and BERT normalizer",
        "tier": "core"
      }
    }
  }
