{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toktier:schema:evidence-manifest:1",
  "title": "toktier evidence manifest",
  "description": "Machine-generated record of a certification run: what was run, on what, and what was observed. Generated by tooling only; hand edits are prohibited and rejected by CI (--check). See docs/contracts/registry.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "generated_by",
    "root_digest",
    "run",
    "oracle",
    "artifacts",
    "corpora",
    "totals",
    "environment"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": { "$ref": "#/$defs/identifier" },
    "generated_by": { "$ref": "#/$defs/generated_by" },
    "root_digest": { "$ref": "#/$defs/sha256_prefixed" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "date"],
      "properties": {
        "run_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "suite_version": { "type": "string" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_sha256", "family"],
        "properties": {
          "artifact_sha256": { "$ref": "#/$defs/sha256_hex" },
          "family": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["corpus_id", "docs", "bytes"],
        "properties": {
          "corpus_id": { "type": "string" },
          "docs": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "shard_digests": {
            "type": "array",
            "items": { "$ref": "#/$defs/sha256_hex" }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs", "bytes", "mismatches"],
      "properties": {
        "docs": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "mismatches": {
          "type": "integer",
          "minimum": 0,
          "description": "Recorded as read; never rounded."
        },
        "routed": {
          "type": "integer",
          "minimum": 0,
          "description": "Inputs routed to the reference path by design (for example added-token literals)."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python"],
      "properties": {
        "os": { "type": "string" },
        "python": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gpus": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the frozen dependency lockfile in effect for the run."
        }
      }
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "source_commit", "generated_at"],
      "properties": {
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
