+    /// Ids to emit for a character that has no vocabulary entry.
+    ///
+    /// Mirrors the reference implementation's resolution order: byte
+    /// fallback when the model enables it and every `<0xXX>` token exists,
+    /// then the unk token, and finally dropping the character. Writes into
+    /// `buf` (a character is at most 4 UTF-8 bytes) and returns how many ids
+    /// were written; `0` means "drop".
+    #[inline]
+    fn unknown_char_ids(&self, s: &str, buf: &mut [u32; 4]) -> usize {
+        if self.byte_fallback {
+            let bytes = s.as_bytes();
+            if bytes
+                .iter()
+                .all(|&b| self.byte_fallback_token_ids[b as usize] != INVALID_TOKEN)
+            {
+                for (slot, &b) in buf.iter_mut().zip(bytes) {
+                    *slot = self.byte_fallback_token_ids[b as usize];
+                }
+                return bytes.len();
+            }
+        }
+        match self.unk_token_id {
+            Some(unk) => {
+                buf[0] = unk;
+                1
+            }
+            None => 0,
+        }
+    }
+
+    /// Cold path for raw input holding bytes with no vocabulary entry:
+    /// ByteLevel-encode and reuse the character engine, which applies the
+    /// byte-fallback / unk / drop resolution above. Equivalent to the fast
+    /// raw paths for every byte that does have a token.
+    #[cold]
+    fn merge_raw_via_encoded(&self, raw_input: &str, out: &mut Vec<u32>) -> Result<()> {
+        let mut encoded = String::with_capacity(raw_input.len() * 2);
+        for &b in raw_input.as_bytes() {
+            encoded.push(BYTE_TO_CHAR[b as usize]);
+        }
+        self.merge_all_encoded_into(&encoded, out)
+    }
+
+    /// Does this raw input hold a byte with no vocabulary entry?
+    #[inline]
+    fn raw_has_unmapped_byte(&self, raw_input: &str) -> bool {
+        raw_input
+            .as_bytes()
+            .iter()
+            .any(|&b| self.byte_to_initial_token[b as usize] == INVALID_TOKEN)
+    }
