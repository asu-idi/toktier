+    #[test]
+    fn unknown_char_without_unk_or_byte_fallback_is_dropped() {
+        // "b" has no entry; the reference implementation emits nothing for
+        // it rather than failing the whole encode.
+        let bpe = bpe_from_json(serde_json::json!({
+            "type": "BPE",
+            "vocab": {"a": 0, "c": 1},
+            "merges": [],
+        }));
+        assert_eq!(bpe.tokenize("abc").unwrap(), vec![0, 1]);
+        assert_eq!(bpe.tokenize("b").unwrap(), Vec::<u32>::new());
+        assert_eq!(bpe.tokenize("bbb").unwrap(), Vec::<u32>::new());
+    }
+
+    #[test]
+    fn unknown_char_uses_unk_token_when_declared() {
+        let bpe = bpe_from_json(serde_json::json!({
+            "type": "BPE",
+            "vocab": {"a": 0, "c": 1, "<unk>": 2},
+            "merges": [],
+            "unk_token": "<unk>",
+        }));
+        assert_eq!(bpe.tokenize("abc").unwrap(), vec![0, 2, 1]);
+        assert_eq!(bpe.tokenize("abbc").unwrap(), vec![0, 2, 2, 1]);
+    }
+
+    #[test]
+    fn fuse_unk_collapses_consecutive_unknowns() {
+        let bpe = bpe_from_json(serde_json::json!({
+            "type": "BPE",
+            "vocab": {"a": 0, "c": 1, "<unk>": 2},
+            "merges": [],
+            "unk_token": "<unk>",
+            "fuse_unk": true,
+        }));
+        assert_eq!(bpe.tokenize("abbc").unwrap(), vec![0, 2, 1]);
+        assert_eq!(bpe.tokenize("abcb").unwrap(), vec![0, 2, 1, 2]);
+    }
+
+    #[test]
+    fn byte_fallback_takes_precedence_over_unk() {
+        let bpe = bpe_from_json(serde_json::json!({
+            "type": "BPE",
+            "vocab": {"a": 0, "<unk>": 1, "<0xC3>": 2, "<0xA9>": 3},
+            "merges": [],
+            "unk_token": "<unk>",
+            "byte_fallback": true,
+        }));
+        // U+00E9 is 0xC3 0xA9 in UTF-8.
+        assert_eq!(bpe.tokenize("a\u{e9}").unwrap(), vec![0, 2, 3]);
+    }
+
+    #[test]
+    fn byte_fallback_falls_back_to_unk_when_a_byte_token_is_missing() {
+        let bpe = bpe_from_json(serde_json::json!({
+            "type": "BPE",
+            "vocab": {"a": 0, "<unk>": 1, "<0xC3>": 2},
+            "merges": [],
+            "unk_token": "<unk>",
+            "byte_fallback": true,
+        }));
+        // <0xA9> is absent, so the whole character resolves to unk.
+        assert_eq!(bpe.tokenize("a\u{e9}").unwrap(), vec![0, 1]);
+    }
+
+    #[test]
+    fn unknown_char_resolution_is_the_same_on_every_merge_path() {
+        // The raw (pre-ByteLevel) entry points must agree with the
+        // character engine when the input holds a byte with no token.
+        let vocab: Vocab = [("a", 0u32), ("b", 1), ("ab", 2)]
+            .into_iter()
+            .map(|(s, id)| (s.to_string(), id))
+            .collect();
+        let merges = vec![Value::String("a b".into())];
+        let merge_map = parse_merges(&vocab, &merges).unwrap();
+        let bpe = Bpe::new(&vocab, merge_map).unwrap();
+
+        // A carriage return ByteLevel-encodes to U+010D, absent here.
+        for raw in ["a\rb", "\r", "\r\r", "ab\rab"] {
+            let mut fused = Vec::new();
+            bpe.tokenize_into_fused(raw, &mut fused).unwrap();
+
+            let mut encoded = String::new();
+            for &b in raw.as_bytes() {
+                encoded.push(BYTE_TO_CHAR[b as usize]);
+            }
+            let direct = bpe.tokenize(&encoded).unwrap();
+            assert_eq!(fused, direct, "raw path disagrees for {raw:?}");
+        }
+    }
+
+    #[test]
+    fn long_input_with_unmapped_bytes_does_not_fail() {
+        // Beyond SMALL_MERGE_MAX, so the heap raw path is exercised too.
+        let vocab: Vocab = [("a", 0u32), ("b", 1), ("ab", 2)]
+            .into_iter()
+            .map(|(s, id)| (s.to_string(), id))
+            .collect();
+        let merges = vec![Value::String("a b".into())];
+        let merge_map = parse_merges(&vocab, &merges).unwrap();
+        let bpe = Bpe::new(&vocab, merge_map).unwrap();
+
+        let raw = "ab\r".repeat(SMALL_MERGE_MAX);
+        let mut fused = Vec::new();
+        bpe.tokenize_into_fused(&raw, &mut fused).unwrap();
+        assert_eq!(fused, vec![2u32; SMALL_MERGE_MAX]);
+    }
