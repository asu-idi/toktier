+/// End of the pretoken that contains the newline at `last_nl`.
+///
+/// Most alternatives cannot hold a newline at all, and the whitespace ones
+/// (`\s*[\r\n]+`, `\s+(?!\S)`, `\s+`) end at their last newline — for those
+/// the byte after the newline is already a pretoken boundary. The exception is
+/// the punctuation-run alternative ` ?[^\s\p{L}\p{N}]+<tail>`, whose trailing
+/// class keeps going past the newline (see [`newline_tail_byte`]); ending a
+/// chunk there would cut that pretoken across two chunks and change its ids.
+///
+/// Telling the two apart only needs the character in front of the newline run:
+/// walk back over `\r`/`\n` (never over the rest of the trailing class, which
+/// would run into the punctuation run itself and misread it) and look at what
+/// precedes it. Punctuation means we are inside the punctuation-run
+/// alternative, so the pretoken ends at the end of the whole trailing class.
+fn pretoken_end_at_newline(
+    text: &str,
+    b: &[u8],
+    t: &Tables,
+    kind: ScanKind,
+    last_nl: usize,
+) -> usize {
+    let n = b.len();
+    let mut s = last_nl;
+    while s > 0 && (b[s - 1] == b'\r' || b[s - 1] == b'\n') {
+        s -= 1;
+    }
+    let in_punct_run = s > 0
+        && text[..s]
+            .chars()
+            .next_back()
+            .is_some_and(|c| is_punct(t, c));
+    if !in_punct_run {
+        return last_nl + 1;
+    }
+    let mut e = last_nl + 1;
+    while e < n && newline_tail_byte(kind, b[e]) {
+        e += 1;
+    }
+    e
+}
