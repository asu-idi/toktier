+    /// A chunk boundary must never fall inside a pretoken, for any pattern
+    /// kind, any needle, any placement and any chunk count.
+    ///
+    /// The o200k punctuation-run alternative ends with `[\r\n/]*`, so a
+    /// pretoken like `@@\n//` continues past its newline. Placing the boundary
+    /// straight after the last newline cut it in two and silently changed the
+    /// ids of both halves — invisible to a length check, and only reachable on
+    /// inputs long enough to be chunked at all.
+    #[test]
+    fn chunk_bounds_never_split_a_pretoken() {
+        // shapes that do and do not continue past the newline
+        let needles = [
+            "@@\n//", "@@\n/x", "@@\r\n//", "@@\n\n//", "@@\n \n//", "@@\ny", "@@\n..",
+            "a//\n//b", "@@//\n///x", "..\n/", " @@\n//", "@@\n/", "@@\n////////x",
+        ];
+        let filler = "The quick brown fox jumps over the lazy dog. ";
+        for kind in [ScanKind::O200k, ScanKind::Kimi] {
+            for needle in needles {
+                for total in [4_000usize, 40_000, 200_000] {
+                    for frac in [0.1, 0.25, 0.5, 0.75, 0.9] {
+                        let body = filler.repeat(total / filler.len() + 1);
+                        let cut = ((total as f64) * frac) as usize;
+                        let text = format!("{}{needle}{}", &body[..cut], &body[..total - cut]);
+                        let whole = scan(kind, &text);
+                        for n_chunks in [1usize, 2, 3, 4, 8, 16, 32] {
+                            let bounds = newline_chunk_bounds(&text, n_chunks, kind);
+                            let chunked: Vec<String> = bounds
+                                .iter()
+                                .flat_map(|&(s, e)| scan(kind, &text[s..e]))
+                                .collect();
+                            assert_eq!(
+                                chunked, whole,
+                                "kind={kind:?} needle={needle:?} total={total} \
+                                 frac={frac} n_chunks={n_chunks}: chunked scan \
+                                 diverged from whole scan"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    /// The trailing class is shared between the scanner and the chunker; pin
+    /// it so the two cannot drift apart again.
+    #[test]
+    fn newline_tail_class_matches_the_patterns() {
+        // o200k's punctuation alternative ends `[\r\n/]*`
+        assert!(newline_tail_byte(ScanKind::O200k, b'\r'));
+        assert!(newline_tail_byte(ScanKind::O200k, b'\n'));
+        assert!(newline_tail_byte(ScanKind::O200k, b'/'));
+        assert!(!newline_tail_byte(ScanKind::O200k, b'x'));
+        assert!(!newline_tail_byte(ScanKind::O200k, b' '));
+        // Kimi's ends `[\r\n]*` — no slash
+        assert!(newline_tail_byte(ScanKind::Kimi, b'\r'));
+        assert!(newline_tail_byte(ScanKind::Kimi, b'\n'));
+        assert!(!newline_tail_byte(ScanKind::Kimi, b'/'));
+        // and the pattern constants really do say that
+        assert!(crate::tiktoken::O200K_BASE_PATTERN.contains(r"[\r\n/]*"));
+        assert!(crate::tiktoken::KIMI_PATTERN.contains(r"[\r\n]*"));
+        assert!(!crate::tiktoken::KIMI_PATTERN.contains(r"[\r\n/]*"));
+    }
+
+    #[test]
+    fn punct_run_tail_is_one_pretoken() {
+        assert_eq!(scan(ScanKind::O200k, "@@\n//x"), vec!["@@\n//", "x"]);
+        assert_eq!(scan(ScanKind::Kimi, "@@\n//x"), vec!["@@\n", "//", "x"]);
+        // a newline that is not part of a punctuation run stays on its own
+        assert_eq!(scan(ScanKind::O200k, "a\n//x"), vec!["a", "\n", "//", "x"]);
+    }
+
