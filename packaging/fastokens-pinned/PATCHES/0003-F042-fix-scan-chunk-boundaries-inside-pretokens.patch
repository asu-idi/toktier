+/// Bytes that may trail a newline *inside* a pretoken.
+///
+/// The punctuation-run alternative of the recognized patterns ends with a
+/// trailing class after its `[^\s\p{L}\p{N}]+` run: `[\r\n]*` for the Kimi
+/// pattern and `[\r\n/]*` for o200k, which is the only place `/` appears.
+/// Both [`scan_core`] (deciding where a pretoken ends) and
+/// [`newline_chunk_bounds`] (deciding where a chunk may end) have to agree on
+/// this set — they are the same rule seen from two sides, and when only one of
+/// them knew about `/` a chunk boundary could land inside a pretoken and
+/// silently change its ids.
+#[inline(always)]
+pub(crate) fn newline_tail_byte(kind: ScanKind, b: u8) -> bool {
+    b == b'\r' || b == b'\n' || (kind == ScanKind::O200k && b == b'/')
+}
