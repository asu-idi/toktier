+    def _wrap_tokenizer_with_toktier(self, tokenizer):
+        """Wrap the loaded tokenizer so encode calls run on toktier (CPU).
+
+        Every other attribute is delegated to the wrapped tokenizer; the
+        wrapper reads its options from TOKTIER_SGLANG_* (see
+        toktier.integrations.sglang).
+        """
+        try:
+            from toktier.integrations.sglang import wrap_tokenizer
+        except ImportError:
+            raise ImportError(
+                "The toktier package is required when --tokenizer-backend=toktier. "
+                "Install it with: pip install toktier"
+            ) from None
+
+        wrapped = wrap_tokenizer(tokenizer)
+        logger.info("toktier backend enabled - %r", wrapped)
+        return wrapped
+
+    def _tokenizer_request_scope(self, obj):
+        """Scope for backends that keep per-session tokenizer state.
+
+        The toktier backend reads the request's session key (session_id,
+        else cache_salt) from a context variable while it encodes; other
+        backends get a no-op scope.
+        """
+        if get_serving().tokenizer_backend != "toktier":
+            return nullcontext()
+        from toktier.integrations.sglang import (
+            bind_session_key,
+            session_key_from_request,
+        )
+
+        return bind_session_key(session_key_from_request(obj))
+
