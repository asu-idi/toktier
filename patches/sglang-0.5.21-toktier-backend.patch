+    def _tokenizer_request_scope(self, obj):
+        """Scope for backends that keep per-session tokenizer state.
+
+        The toktier backend reads the request's session key (session_id,
+        else cache_salt) from a context variable while it encodes; other
+        backends get a no-op scope.
+        """
+        if get_serving().tokenizer_backend != "toktier":
+            return nullcontext()
