--- a/python/sglang/srt/utils/hf_transformers/tokenizer.py
+++ b/python/sglang/srt/utils/hf_transformers/tokenizer.py
@@ -467,6 +467,25 @@
     logger.info("fastokens backend enabled - transformers patched successfully")
 
 
+def _wrap_with_toktier(tokenizer):
+    """Wrap an already loaded tokenizer so encode calls run on toktier (CPU).
+
+    Every other attribute is delegated to the wrapped tokenizer; the wrapper
+    reads its options from TOKTIER_SGLANG_* (see toktier.integrations.sglang).
+    """
+    try:
+        from toktier.integrations.sglang import wrap_tokenizer
+    except ImportError:
+        raise ImportError(
+            "The toktier package is required when --tokenizer-backend=toktier. "
+            "Install it with: pip install toktier"
+        ) from None
+
+    wrapped = wrap_tokenizer(tokenizer)
+    logger.info("toktier backend enabled - %r", wrapped)
+    return wrapped
+
+
 def get_tokenizer(
     tokenizer_name: str,
     *args,
@@ -550,7 +569,12 @@
                     tokenizer_name, *args, **common_kwargs
                 )
 
-        return _apply_post_load_fixes(tokenizer, tokenizer_name, tokenizer_revision)
+        tokenizer = _apply_post_load_fixes(
+            tokenizer, tokenizer_name, tokenizer_revision
+        )
+        if tokenizer_backend == "toktier":
+            tokenizer = _wrap_with_toktier(tokenizer)
+        return tokenizer
