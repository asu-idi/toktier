{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toktier:schema:chunked-admission:1",
  "title": "toktier chunked admission table",
  "description": "The artifacts the chunk-parallel path (toktier.chunked) may chunk, one row per certified family and artifact digest, with the paths (python, native) whose evidence is recorded. Generated by tools/update_chunked_admission.py from readings/chunked_cuts_campaign.json and shipped inside the package; the module refuses a tokenizer without a row at run time. chunked_identity binds the Python path to the source it was recorded on, fast_cpu_source_digest_v2 the native path to the engine's version-normalized identity. Hand edits are rejected by --check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_by",
    "root_digest",
    "chunked_identity",
    "fast_cpu_source_digest_v2",
    "rows"
  ],
  "properties": {
    "schema": { "const": "toktier.chunked_admission.v1" },
    "schema_version": { "const": 1 },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "source_commit", "generated_at"],
      "properties": {
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "root_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "chunked_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fast_cpu_source_digest_v2": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "artifact_sha256",
          "normalizer",
          "paths",
          "evidence_id",
          "corpus_docs",
          "adversarial_strings"
        ],
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "maxLength": 128
          },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "normalizer": { "enum": ["none", "nfc"] },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["python", "native"] }
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "maxLength": 128
          },
          "corpus_docs": { "type": "integer", "minimum": 0 },
          "adversarial_strings": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
