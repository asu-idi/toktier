{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toktier:schema:support-registry:1",
  "title": "toktier support registry",
  "description": "Machine-generated certification registry. Generated by tooling only; hand edits are prohibited and rejected by CI (--check). See docs/contracts/registry.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "root_digest",
    "oracles",
    "pipelines",
    "added_frontends",
    "artifacts",
    "compositions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "$ref": "#/$defs/generated_by" },
    "root_digest": { "$ref": "#/$defs/sha256_prefixed" },
    "oracles": {
      "type": "array",
      "items": { "$ref": "#/$defs/oracle" }
    },
    "pipelines": {
      "type": "array",
      "items": { "$ref": "#/$defs/pipeline" }
    },
    "added_frontends": {
      "type": "array",
      "items": { "$ref": "#/$defs/added_frontend" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_record" }
    },
    "compositions": {
      "type": "array",
      "description": "Explicit, evidence-backed composition grants. Absent an entry, pipeline + added-frontend capability matches do not grant accelerated eligibility (default-closed).",
      "items": { "$ref": "#/$defs/composition" }
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "source_commit", "generated_at"],
      "properties": {
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_id", "package", "certified_versions", "semantic_id"],
      "properties": {
        "oracle_id": { "$ref": "#/$defs/identifier" },
        "package": { "type": "string" },
        "certified_versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Exact package versions this behavior class was judged against."
        },
        "semantic_id": {
          "$ref": "#/$defs/identifier",
          "description": "Behavior-equivalence-class identifier bound by the semantic fingerprint. Widening a class to more versions requires certification evidence."
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_id", "pipeline_fingerprint"],
      "properties": {
        "pipeline_id": { "$ref": "#/$defs/identifier" },
        "pipeline_fingerprint": { "$ref": "#/$defs/sha256_hex" },
        "description": { "type": "string" }
      }
    },
    "added_frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added_frontend_id", "added_frontend_fingerprint"],
      "properties": {
        "added_frontend_id": { "$ref": "#/$defs/identifier" },
        "added_frontend_fingerprint": { "$ref": "#/$defs/sha256_hex" },
        "description": { "type": "string" }
      }
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs", "bytes", "mismatches"],
      "properties": {
        "docs": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "mismatches": {
          "type": "integer",
          "minimum": 0,
          "description": "Recorded as read; never rounded."
        }
      }
    },
    "backend_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["certified", "certified_source", "experimental", "unsupported"]
        },
        "binary_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Required when status is certified."
        },
        "source_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Required when status is certified_source: digest of the kernel source set."
        },
        "build_flags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Bound build flags for certified_source."
        },
        "toolchain": {
          "type": "string",
          "description": "Toolchain constraint expression for certified_source (for example a CUDA toolkit version range)."
        },
        "class_table_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the generated lookup tables (character-class tables) the kernel consumes. Part of the certificate binding set; a mismatch closes the accelerated path."
        },
        "devices": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Exact GPU architectures judged (for example sm_89, sm_120). An unlisted architecture is not eligible under CERTIFIED."
        },
        "devices_experimental": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Architectures the delivery ships an image for without judgment evidence. Reachable only under EXPERIMENTAL policy; reported as experimental, never as certified."
        },
        "architecture_digests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256_hex" },
          "description": "Digest of each embedded per-architecture image (domain-tagged sha256, bare hex), keyed by the architecture spelling."
        },
        "driver_min": { "type": "string" },
        "engine": {
          "$ref": "#/$defs/identifier",
          "description": "External engine distribution selected by this backend."
        },
        "engine_version": {
          "type": "string",
          "description": "Exact external engine version in the certified binding."
        },
        "engine_delivery": {
          "enum": ["vendored"],
          "description": "How the CPU engine is delivered. The first release admits only the private module vendored in the core wheel."
        },
        "engine_module": {
          "type": "string",
          "const": "toktier._vendor.gigatoken_rs",
          "description": "Private import path of the bound CPU engine; no top-level Gigatoken package participates in routing."
        },
        "engine_unicode_data": {
          "type": "string",
          "description": "Unicode-data provenance of the bound external engine build."
        },
        "patch_sha256": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the downstream patch applied to the external engine."
        },
        "config_id": {
          "$ref": "#/$defs/identifier",
          "description": "Frozen repair algorithm/configuration identifier."
        },
        "config_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the packaged repair-family table consumed at runtime."
        },
        "deliveries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jit": { "$ref": "#/$defs/backend_entry" },
            "prebuilt": { "$ref": "#/$defs/backend_entry" }
          },
          "description": "Per-delivery refinement of this entry. 'jit' binds the source digest set (certified_source), 'prebuilt' binds the shipped fatbin binary digest (certified). The top-level fields remain the JIT-era view for readers that predate deliveries."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "certified" } } },
          "then": { "required": ["binary_digest"] }
        },
        {
          "if": { "properties": { "status": { "const": "certified_source" } } },
          "then": {
            "required": [
              "source_digest",
              "build_flags",
              "toolchain",
              "devices",
              "class_table_digest"
            ]
          }
        }
      ]
    },
    "artifact_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "family",
        "pipeline_id",
        "added_frontend_id",
        "oracle_id",
        "suite_version",
        "evidence_id",
        "readings",
        "backends"
      ],
      "properties": {
        "artifact_sha256": { "$ref": "#/$defs/sha256_hex" },
        "family": { "$ref": "#/$defs/identifier" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "pipeline_id": { "$ref": "#/$defs/identifier" },
        "added_frontend_id": { "$ref": "#/$defs/identifier" },
        "oracle_id": { "$ref": "#/$defs/identifier" },
        "suite_version": { "type": "string" },
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "readings": { "$ref": "#/$defs/readings" },
        "backends": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/backend_entry" },
          "propertyNames": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_id", "added_frontend_id", "evidence_id"],
      "properties": {
        "pipeline_id": { "$ref": "#/$defs/identifier" },
        "added_frontend_id": { "$ref": "#/$defs/identifier" },
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "note": { "type": "string" }
      }
    }
  }
}
