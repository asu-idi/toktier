{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toktier:schema:support-registry:1",
  "title": "toktier support registry",
  "description": "Machine-generated certification registry. Generated by tooling only; hand edits are prohibited and rejected by CI (--check). See docs/contracts/registry.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "root_digest",
    "oracles",
    "pipelines",
    "added_frontends",
    "artifacts",
    "compositions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "$ref": "#/$defs/generated_by"
    },
    "root_digest": {
      "$ref": "#/$defs/sha256_prefixed"
    },
    "oracles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oracle"
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "added_frontends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/added_frontend"
      }
    },
    "runtime_builds": {
      "type": "array",
      "description": "Evidence-bound native serving hosts allowed to admit accelerated routes.",
      "items": {
        "$ref": "#/$defs/runtime_build"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_record"
      }
    },
    "compositions": {
      "type": "array",
      "description": "Explicit, evidence-backed composition grants. Absent an entry, pipeline + added-frontend capability matches do not grant accelerated eligibility (default-closed).",
      "items": {
        "$ref": "#/$defs/composition"
      }
    },
    "engine_distributions": {
      "type": "object",
      "description": "Engine distributions the project publishes for an explicitly admitted adapter. The node records which published bytes the adapter's evidence describes; it is not a backend status and grants no route.",
      "additionalProperties": false,
      "properties": {
        "fastokens": {
          "$ref": "#/$defs/engine_distribution"
        }
      }
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "source_commit",
        "generated_at"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_id",
        "package",
        "certified_versions",
        "semantic_id"
      ],
      "properties": {
        "oracle_id": {
          "$ref": "#/$defs/identifier"
        },
        "package": {
          "type": "string"
        },
        "certified_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Exact package versions this behavior class was judged against."
        },
        "semantic_id": {
          "$ref": "#/$defs/identifier",
          "description": "Behavior-equivalence-class identifier bound by the semantic fingerprint. Widening a class to more versions requires certification evidence."
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_id",
        "pipeline_fingerprint"
      ],
      "properties": {
        "pipeline_id": {
          "$ref": "#/$defs/identifier"
        },
        "pipeline_fingerprint": {
          "$ref": "#/$defs/sha256_hex"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "added_frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_frontend_id",
        "added_frontend_fingerprint"
      ],
      "properties": {
        "added_frontend_id": {
          "$ref": "#/$defs/identifier"
        },
        "added_frontend_fingerprint": {
          "$ref": "#/$defs/sha256_hex"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "runtime_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "source_digest",
        "build_flags",
        "toolchain",
        "fast_cpu_source_digest",
        "native_host_source_digest",
        "evidence_id"
      ],
      "properties": {
        "runtime": {
          "const": "rust_api"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256_hex"
        },
        "source_digest_v2": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Version-normalized v2 identity over the runtime source set."
        },
        "build_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "toolchain": {
          "type": "string"
        },
        "fast_cpu_source_digest": {
          "$ref": "#/$defs/sha256_hex"
        },
        "fast_cpu_source_digest_v2": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Version-normalized v2 identity over the integrated fast-CPU source set."
        },
        "native_host_source_digest": {
          "$ref": "#/$defs/sha256_hex"
        },
        "native_host_source_digest_v2": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Version-normalized v2 identity over the native-host source set."
        },
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "direct_jit_toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "build",
        "compiler_sha256",
        "architecture",
        "evidence_id"
      ],
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "compiler_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "architecture": {
          "type": "string",
          "pattern": "^sm_[0-9]+$"
        },
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docs",
        "bytes",
        "mismatches"
      ],
      "properties": {
        "docs": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0,
          "description": "Recorded as read; never rounded."
        }
      }
    },
    "backend_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "certified",
            "certified_source",
            "experimental",
            "unsupported"
          ]
        },
        "binary_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Required when status is certified."
        },
        "source_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Required when status is certified_source: digest of the kernel source set."
        },
        "source_digest_v2": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Version-normalized v2 identity paired with an integrated source_digest."
        },
        "build_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Bound build flags for certified_source."
        },
        "toolchain": {
          "type": "string",
          "description": "Toolchain constraint expression for certified_source (for example a CUDA toolkit version range)."
        },
        "host_source_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Domain-separated digest of the Rust request host paired with a certified prebuilt GPU image. The release verifier requires it on every prebuilt delivery marked certified."
        },
        "host_source_digest_v2": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Version-normalized v2 identity of the Rust request host."
        },
        "host_build_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact release build facts embedded by the native prebuilt request host."
        },
        "host_toolchain": {
          "type": "string",
          "description": "Exact Rust compiler identity embedded by the native prebuilt request host."
        },
        "direct_source_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Domain-separated digest of the exact standalone NVCC source set used by the Rust-native JIT compiler."
        },
        "direct_host_source_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Domain-separated digest of the Rust CUDA Driver request host that loads a direct-JIT product."
        },
        "direct_host_source_digest_v2": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Version-normalized v2 identity of the direct-JIT Rust request host."
        },
        "direct_build_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Exact invariant direct-NVCC flag prefix; device and path arguments are bound separately in the per-product manifest."
        },
        "direct_devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^sm_[0-9]+$"
          }
        },
        "direct_toolchains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/direct_jit_toolchain"
          },
          "description": "Exact compiler-binary/architecture tuples admitted for automatic Rust-native direct JIT."
        },
        "class_table_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the generated lookup tables (character-class tables) the kernel consumes. Part of the certificate binding set; a mismatch closes the accelerated path."
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact GPU architectures judged (for example sm_89, sm_120). An unlisted architecture is not eligible under CERTIFIED."
        },
        "devices_experimental": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Architectures the delivery ships an image for without judgment evidence. Reachable only under EXPERIMENTAL policy; reported as experimental, never as certified."
        },
        "architecture_digests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256_hex"
          },
          "description": "Digest of each embedded per-architecture image (domain-tagged sha256, bare hex), keyed by the architecture spelling."
        },
        "driver_min": {
          "type": "string"
        },
        "engine": {
          "$ref": "#/$defs/identifier",
          "description": "External engine distribution selected by this backend."
        },
        "engine_version": {
          "type": "string",
          "description": "Exact external engine version in the certified binding."
        },
        "engine_delivery": {
          "enum": [
            "integrated",
            "vendored"
          ],
          "description": "How the CPU engine is delivered. 'integrated' means the corrected implementation is linked into the core TokTier extension; 'vendored' is retained only for reading the 0.1.0 lineage."
        },
        "engine_module": {
          "type": "string",
          "enum": [
            "toktier._native",
            "toktier._vendor.gigatoken_rs"
          ],
          "description": "Private import path of the bound CPU engine; no top-level Gigatoken package participates in routing."
        },
        "engine_unicode_data": {
          "type": "string",
          "description": "Unicode-data provenance of the bound external engine build."
        },
        "patch_sha256": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the downstream patch applied to the external engine."
        },
        "config_id": {
          "$ref": "#/$defs/identifier",
          "description": "Frozen repair algorithm/configuration identifier."
        },
        "config_digest": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Digest of the packaged repair-family table consumed at runtime."
        },
        "deliveries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jit": {
              "$ref": "#/$defs/backend_entry"
            },
            "prebuilt": {
              "$ref": "#/$defs/backend_entry"
            }
          },
          "description": "Per-delivery refinement of this entry. 'jit' binds the kernel source digest set (certified_source); 'prebuilt' binds the shipped fatbin binary plus the source/build identity of its Rust request host (certified). The top-level fields remain the JIT-era view for readers that predate deliveries."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "certified"
              }
            }
          },
          "then": {
            "required": [
              "binary_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "certified_source"
              }
            }
          },
          "then": {
            "required": [
              "source_digest",
              "build_flags",
              "toolchain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "certified_source"
              }
            },
            "not": {
              "required": [
                "engine"
              ]
            }
          },
          "then": {
            "required": [
              "devices",
              "class_table_digest"
            ]
          }
        }
      ]
    },
    "artifact_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "family",
        "pipeline_id",
        "added_frontend_id",
        "oracle_id",
        "suite_version",
        "evidence_id",
        "readings",
        "backends"
      ],
      "properties": {
        "artifact_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "family": {
          "$ref": "#/$defs/identifier"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "pipeline_id": {
          "$ref": "#/$defs/identifier"
        },
        "added_frontend_id": {
          "$ref": "#/$defs/identifier"
        },
        "oracle_id": {
          "$ref": "#/$defs/identifier"
        },
        "suite_version": {
          "type": "string"
        },
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "readings": {
          "$ref": "#/$defs/readings"
        },
        "backends": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/backend_entry"
          },
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          }
        },
        "config_added_tokens": {
          "$ref": "#/$defs/config_added_tokens"
        },
        "carryover": {
          "$ref": "#/$defs/carryover"
        }
      }
    },
    "config_added_tokens": {
      "description": "Configuration-side added-token subset of the certified subject: added tokens the loader face carries beyond the artifact file. sha256 is over the canonical id-ascending row form (id, content, matching-semantics flags; sorted keys, no whitespace).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "count",
        "source"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "const": "tokenizer_config.json"
        }
      }
    },
    "carryover": {
      "description": "Corpus-equivalence carry-over: the recorded readings were taken under an earlier judge definition and remain valid under the current one because every literal of the divergence set is absent from the judged corpus, per the named absence certificate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "from_subject",
        "to_subject",
        "divergence_set",
        "certificate"
      ],
      "properties": {
        "mechanism": {
          "const": "corpus_equivalence"
        },
        "from_subject": {
          "type": "string",
          "minLength": 1
        },
        "to_subject": {
          "type": "string",
          "minLength": 1
        },
        "divergence_set": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "docs",
            "chars",
            "occurrences"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^readings/[^#]+\\.json$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256_hex"
            },
            "docs": {
              "type": "integer",
              "minimum": 1
            },
            "chars": {
              "type": "integer",
              "minimum": 1
            },
            "occurrences": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_id",
        "added_frontend_id",
        "evidence_id"
      ],
      "properties": {
        "pipeline_id": {
          "$ref": "#/$defs/identifier"
        },
        "added_frontend_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "engine_distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "fastokens"
        },
        "admission": {
          "const": "experimental",
          "description": "How the adapter is selected: only by explicit request under the EXPERIMENTAL policy. Never changed by anything in this node."
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "import_name": {
              "type": "string",
              "minLength": 1
            },
            "requires_python": {
              "type": "string",
              "minLength": 1
            },
            "abi": {
              "type": "string",
              "minLength": 1
            },
            "index": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version",
            "import_name",
            "requires_python",
            "abi",
            "index"
          ]
        },
        "recognised_distributions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Distribution names whose RECORD may own the import package; the adapter resolves identity by the import package and attributes the bytes on disk to one of these."
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1
            },
            "distribution": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "previous_repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "project",
            "distribution",
            "version",
            "repository",
            "tag",
            "commit",
            "license"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patch_series": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256_hex"
                  },
                  "changes_code": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "file",
                  "sha256",
                  "changes_code"
                ]
              }
            },
            "code_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "noticed_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "recipe": {
              "type": "string",
              "minLength": 1
            },
            "toolchain": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rustc": {
                  "type": "string",
                  "minLength": 1
                },
                "cargo": {
                  "type": "string",
                  "minLength": 1
                },
                "maturin": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "rustc",
                "cargo",
                "maturin",
                "host"
              ]
            }
          },
          "required": [
            "patch_series",
            "code_tree",
            "noticed_tree",
            "recipe",
            "toolchain"
          ]
        },
        "known_wheels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256_hex"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "engine_digest": {
                "$ref": "#/$defs/sha256_hex"
              },
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "abi": {
                "type": "string",
                "minLength": 1
              },
              "built_from_tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "built_by": {
                "type": "string",
                "minLength": 1
              },
              "published": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "string",
                    "minLength": 1
                  },
                  "upload_time": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "index",
                  "upload_time"
                ]
              },
              "code_files": {
                "type": "array",
                "minItems": 1,
